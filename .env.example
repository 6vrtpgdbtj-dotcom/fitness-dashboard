# Copy to .env.local for local integration only; never commit real values.
# Production/Preview: configure separately in Vercel Project Settings > Environment Variables.
# Owners, callbacks, bootstrap and acceptance: docs/deployment.md.

# Supabase project operator: Project URL + anon public key (browser-visible).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project operator: service_role key. SERVER ONLY; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Deployment operator: exact canonical HTTPS origin in hosted environments, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Cloud project operator: OAuth web application client for separate Sheets consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URI to that Google client's authorized redirect URIs.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# Security operator: independent random key, 32 bytes encoded as 64 hex characters or base64.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Security operator: independent random secret, at least 32 characters (recommend 32 random bytes as hex).
GOOGLE_NOTIFICATION_SECRET=
# Security operator: independent random bearer secret; Vercel sends it to the reconciliation cron.
CRON_SECRET=

# Deprecated aliases accepted only when the corresponding canonical value above is empty/unset:
# GOOGLE_OAUTH_CLIENT_ID=       -> GOOGLE_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET=   -> GOOGLE_CLIENT_SECRET
# GOOGLE_WATCH_SECRET=         -> GOOGLE_NOTIFICATION_SECRET
# Set canonical client ID and secret together. Do not leave conflicting alias values configured.
